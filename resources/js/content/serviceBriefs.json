{
  "version": 1,
  "steps": [
    {"id": "business", "title": ["Your business", "Ваш бізнес", "Afacerea ta"], "fields": ["brand_name", "product", "website_url", "locations", "business_country"]},
    {"id": "goal", "title": ["Your goal", "Ваша мета", "Obiectivul tău"], "fields": ["goal", "destination", "audience", "offer", "platforms", "store_status", "catalog_size"]},
    {"id": "readiness", "title": ["Budget and readiness", "Бюджет і готовність", "Buget și pregătire"], "fields": ["budget", "currency", "account", "tracking", "catalog_source", "feed", "order_owner"]},
    {"id": "materials", "title": ["Materials and launch", "Матеріали та запуск", "Materiale și lansare"], "fields": ["creatives", "materials_url", "tiktok_account", "spark", "restrictions", "timing"]},
    {"id": "contact", "title": ["Contact and review", "Контакт і перевірка", "Contact și verificare"], "fields": ["client_name", "client_email", "notes"]}
  ],
  "fields": {
    "brand_name": {"label": ["Business name", "Назва бізнесу", "Numele afacerii"], "placeholder": ["e.g. North Star Studio", "Наприклад, North Star Studio", "ex. North Star Studio"], "required": true},
    "product": {"label": ["What do you sell?", "Що ви продаєте?", "Ce vinzi?"], "placeholder": ["Describe your products or services, prices and key benefits", "Опишіть товари чи послуги, ціни та переваги", "Descrie produsele sau serviciile, prețurile și avantajele"], "type": "textarea", "required": true},
    "website_url": {"label": ["Website or social page, if available", "Сайт або соцмережа, якщо є", "Site sau pagină socială, dacă există"], "placeholder": ["https://example.com", "https://example.com", "https://example.com"], "type": "url"},
    "locations": {"label": ["Where are your customers?", "Де ваші клієнти?", "Unde sunt clienții tăi?"], "placeholder": ["e.g. Ukraine, Kyiv", "Наприклад, Україна, Київ", "ex. Ucraina, Chișinău"], "required": true},
    "business_country": {"label": ["Country of business registration", "Країна реєстрації бізнесу", "Țara de înregistrare a afacerii"], "placeholder": ["e.g. Ukraine", "Наприклад, Україна", "ex. Moldova"], "services": ["tiktok-ads"], "required": true},
    "goal": {"label": ["Main goal", "Головна мета", "Obiectiv principal"], "type": "select", "options": ["leads", "sales", "messages", "traffic", "views", "app", "unknown"], "exclude": ["marketplaces"], "required": true},
    "destination": {"label": ["Where should customers contact you?", "Куди клієнтам звертатися?", "Unde să te contacteze clienții?"], "placeholder": ["e.g. WhatsApp, phone or website form", "Наприклад, WhatsApp, телефон або форма на сайті", "ex. WhatsApp, telefon sau formular pe site"], "when": {"field": "goal", "values": ["messages", "leads"]}},
    "audience": {"label": ["Who is your customer? Leave blank if unsure.", "Хто ваш клієнт? Можна пропустити, якщо не знаєте.", "Cine este clientul tău? Poți omite dacă nu știi."], "placeholder": ["e.g. parents aged 25–40 in Kyiv", "Наприклад, батьки 25–40 років у Києві", "ex. părinți de 25–40 de ani din Chișinău"], "exclude": ["marketplaces"]},
    "offer": {"label": ["What makes your offer useful?", "Чим корисна ваша пропозиція?", "Ce face oferta ta utilă?"], "placeholder": ["e.g. first visit discount or free consultation", "Наприклад, знижка на перший візит або безплатна консультація", "ex. reducere la prima vizită sau consultație gratuită"], "type": "textarea", "exclude": ["marketplaces"]},
    "platforms": {"label": ["Marketplace", "Маркетплейс", "Marketplace"], "type": "select", "options": ["rozetka", "prom", "allo", "several", "unknown"], "services": ["marketplaces"], "required": true},
    "store_status": {"label": ["What support do you need?", "Який супровід потрібен?", "De ce ajutor ai nevoie?"], "type": "select", "options": ["new", "existing", "both", "unknown"], "services": ["marketplaces"]},
    "catalog_size": {"label": ["Approximate number of products", "Приблизна кількість товарів", "Numărul aproximativ de produse"], "placeholder": ["e.g. 50", "Наприклад, 50", "ex. 50"], "services": ["marketplaces"]},
    "budget": {"label": ["Monthly ad budget / marketplace project budget (optional)", "Місячний рекламний бюджет / бюджет проєкту маркетплейсу (необов’язково)", "Buget publicitar lunar / buget proiect marketplace (opțional)"], "placeholder": ["e.g. 1,000", "Наприклад, 1 000", "ex. 1.000"], "type": "number"},
    "currency": {"label": ["Currency", "Валюта", "Monedă"], "type": "select", "options": ["UAH", "EUR", "USD", "MDL"], "when": {"field": "budget", "filled": true}, "required": true},
    "account": {"label": ["Do you have an advertising account?", "Є рекламний кабінет?", "Ai un cont publicitar?"], "type": "select", "options": ["yes", "no", "unknown"], "exclude": ["marketplaces"]},
    "tracking": {"label": ["Are website conversions measured?", "Чи вимірюються конверсії на сайті?", "Sunt măsurate conversiile pe site?"], "type": "select", "options": ["yes", "no", "unknown"], "when": {"field": "goal", "values": ["sales", "traffic"]}},
    "catalog_source": {"label": ["Where do you manage prices and stock?", "Де ведете ціни й залишки?", "Unde gestionezi prețurile și stocurile?"], "placeholder": ["e.g. website, spreadsheet or ERP", "Наприклад, сайт, таблиця або ERP", "ex. site, tabel sau ERP"], "services": ["marketplaces"]},
    "feed": {"label": ["Do you have a catalogue export?", "Є вивантаження каталогу?", "Ai un export al catalogului?"], "type": "select", "options": ["yes", "no", "unknown"], "services": ["marketplaces"]},
    "order_owner": {"label": ["Who handles orders, delivery and returns?", "Хто обробляє замовлення, доставку й повернення?", "Cine gestionează comenzile, livrarea și retururile?"], "placeholder": ["e.g. business owner or store manager", "Наприклад, власник бізнесу або менеджер магазину", "ex. proprietar sau managerul magazinului"], "services": ["marketplaces"]},
    "creatives": {"label": ["Materials for the project", "Матеріали для проєкту", "Materiale pentru proiect"], "type": "select", "options": ["own", "make", "ugc", "unknown"]},
    "materials_url": {"label": ["Link to materials (optional)", "Посилання на матеріали (необов’язково)", "Link către materiale (opțional)"], "placeholder": ["https://drive.google.com/...", "https://drive.google.com/...", "https://drive.google.com/..."], "type": "url", "when": {"field": "creatives", "values": ["own"]}},
    "tiktok_account": {"label": ["Do you have a TikTok account?", "Є TikTok-акаунт?", "Ai un cont TikTok?"], "type": "select", "options": ["yes", "no", "unknown"], "services": ["tiktok-ads"]},
    "spark": {"label": ["Use your published videos in advertising?", "Використати ваші опубліковані відео в рекламі?", "Folosim videourile tale publicate în publicitate?"], "type": "select", "options": ["yes", "no", "unknown"], "services": ["tiktok-ads"], "when": {"field": "tiktok_account", "values": ["yes"]}},
    "restrictions": {"label": ["Product restrictions or important details (optional)", "Обмеження продукту або важливі деталі (необов’язково)", "Restricții ale produsului sau detalii importante (opțional)"], "placeholder": ["Share any advertising restrictions or important context", "Згадайте обмеження реклами або важливі деталі", "Menționează restricții publicitare sau detalii importante"], "type": "textarea"},
    "timing": {"label": ["Preferred launch date, if known", "Бажаний строк запуску, якщо відомо", "Data dorită pentru lansare, dacă o cunoști"], "placeholder": ["e.g. October 2026", "Наприклад, жовтень 2026", "ex. octombrie 2026"]},
    "client_name": {"label": ["Your name", "Ваше ім’я", "Numele tău"], "placeholder": ["e.g. Alex", "Наприклад, Олексій", "ex. Alex"], "required": true},
    "client_email": {"label": ["Email", "Email", "Email"], "placeholder": ["name@example.com", "name@example.com", "name@example.com"], "type": "email", "required": true},
    "notes": {"label": ["Anything else? (optional)", "Щось іще? (необов’язково)", "Alte detalii? (opțional)"], "placeholder": ["Links, questions or details we should know", "Посилання, запитання або важливі деталі", "Linkuri, întrebări sau detalii utile"], "type": "textarea"}
  },
  "options": {
    "leads": ["Inquiries", "Заявки", "Solicitări"], "sales": ["Website purchases", "Покупки на сайті", "Cumpărări pe site"], "messages": ["Messages", "Повідомлення", "Mesaje"], "traffic": ["Website visits", "Відвідування сайту", "Vizite pe site"], "views": ["Video views", "Перегляди відео", "Vizualizări video"], "app": ["App installs", "Встановлення застосунку", "Instalări de aplicație"], "unknown": ["Not sure — please advise", "Не знаю — потрібна допомога", "Nu știu — am nevoie de ajutor"], "yes": ["Yes", "Так", "Da"], "no": ["No", "Ні", "Nu"], "new": ["New store", "Новий магазин", "Magazin nou"], "existing": ["Support an existing store", "Супровід наявного магазину", "Administrarea magazinului existent"], "both": ["Launch and ongoing support", "Запуск і супровід", "Lansare și administrare"], "own": ["I have materials", "Маю матеріали", "Am materiale"], "make": ["Help create materials", "Допоможіть створити матеріали", "Ajutați-mă să creez materiale"], "ugc": ["Discuss creator videos / UGC", "Обговорити відео авторів / UGC", "Discutăm video de la creatori / UGC"], "rozetka": ["Rozetka", "Rozetka", "Rozetka"], "prom": ["Prom", "Prom", "Prom"], "allo": ["Allo", "Allo", "Allo"], "several": ["Several platforms", "Кілька майданчиків", "Mai multe platforme"]
  }
}
